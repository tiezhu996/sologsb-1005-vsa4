{
  "name": "patent-claim-mapping-workbench",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production",
    "test:logic": "esbuild scripts/test-review-merge.mts --bundle --platform=node --format=esm --log-level=warning --outfile=scripts/.test-build.mjs && node scripts/.test-build.mjs",
    "test:store": "esbuild scripts/test-case-store.mts --bundle --platform=node --format=esm --log-level=warning --outfile=scripts/.test-store.mjs && node scripts/.test-store.mjs",
    "test": "npm run test:logic && npm run test:store"
  },
  "dependencies": {
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@angular/router": "19.2.25",
    "@primeng/themes": "19.0.0",
    "primeicons": "7.0.0",
    "primeng": "19.1.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "19.2.27",
    "@angular/cli": "19.2.27",
    "@angular/compiler-cli": "19.2.25",
    "typescript": "5.7.3"
  }
}
